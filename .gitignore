.cxx/

# Node artifacts (stray, not part of this Android project)
package.json
package-lock.json
node_modules/

# Headless JVM app: host-built native lib, CMake tree, run-time staging/cache & WAV output
apps/jvm/libs/
apps/jvm/native-build/
apps/jvm/.chipbox-jvm/
# Same cache dir under whatever working directory the JVM app is launched from (e.g. repo root).
.chipbox-jvm/
apps/jvm/Chipbox Output Files/
# CLI app: per-working-directory library DB + saved scan locations (created wherever it's run)
.chipbox-cli/
# A/B render harness: per-run WAV + metrics output (default --out dir, created wherever it's run)
ab-runs/
# A/B render harness: runs pulled off a device by apps/abrender-core/run-on-device.sh (default --out)
ab-runs-device/
# A/B render harness: device-vs-host comparison runs from apps/abrender-core/ab-compare.sh (default --out)
ab-compare/
*.so
# Stray top-level yarn.lock (only locks `yarn` itself) that a bare `yarn` run in the repo root
# leaves behind. It shadows kotlin-js-store/yarn.lock and breaks Dependabot's JS evaluation.
# The real Kotlin/JS lockfile lives at kotlin-js-store/yarn.lock and is committed.
/yarn.lock

# JVM crash dumps from the headless app
apps/jvm/hs_err_pid*.log
apps/jvm/core.*
.chipbox-server/

# Claude Code local state
.claude/

# Local-only helper scripts (e.g. nas-tng CI-runner payloads) — not part of the repo
scripts/local/

# MkDocs build output (landing site)
/site/
