# Keep the build context to things the Gradle/Docker build actually reads.
# NEVER exclude `sage/`: it is a submodule and a build input. Never exclude
# `kotlin-js-store/yarn.lock` either — it pins the whole Kotlin/JS toolchain.

.git
**/.git
.gitmodules
.github
.gradle
.kotlin
**/build
**/node_modules
node_modules
**/.cxx
apps/android/.externalNativeBuild
apps/android/.cxx
apps/jvm/libs
ab-runs
ab-goldens
.scratch
site
local.properties
*.apk
*.aab
*.log
*.hprof
.DS_Store
build/verification
build/paparazzi-review
# The release job writes the multi-arch OCI archive here before the single-arch smoke builds; keep
# it out of the build context so the second/third image builds don't copy a multi-hundred-MB tar.
build/chipbox-server-multiarch.tar
.docker-cache
