.gitmodules
.github
.gradle
.kotlin
**/build
**/node_modules
node_modules
**/.cxx
apps/android/.externalNativeBuild
apps/android/.cxx
apps/jvm/libs
ab-runs
ab-goldens
.scratch
site
local.properties
*.apk
*.aab
*.log
*.hprof
.DS_Store
build/verification
build/paparazzi-review
