<!--
  Debug-variant overlay for the adaptive-icon background. Same diagonal-gradient shape as the
  release (yellow) background, recolored to the Chipbox secondary purple so the debug install's
  icon is instantly distinguishable. The dark stop is secondaryLight (#625690) from the theme
  palette; the light stop is a brighter tint of it.
  -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="28.575"
    android:viewportHeight="28.575">
  <path
      android:pathData="M0,0h28.575v28.575h-28.575z"
      android:strokeLineJoin="round"
      android:strokeWidth="0.0558984">
      <aapt:attr name="android:fillColor">
          <gradient
              android:startX="4.185"
              android:startY="4.185"
              android:endX="24.39"
              android:endY="24.39"
              android:type="linear">
              <item
                  android:offset="0"
                  android:color="#FF8A7CC9" />
              <item
                  android:offset="1"
                  android:color="#FF625690" />
          </gradient>
      </aapt:attr>
  </path>
</vector>
